# $PATH.
export PATH="/opt/homebrew/opt/ruby/bin:$PATH"
export PATH="/opt/homebrew/lib/ruby/gems/3.1.0/bin:$PATH"

# $EDITOR.
export EDITOR="nvim"

# Load NVM
eval "$(/opt/homebrew/bin/brew shellenv)"
[ -s '/opt/homebrew/opt/nvm/nvm.sh' ] && \. '/opt/homebrew/opt/nvm/nvm.sh'  # This loads nvm
[ -s '/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm' ] && \. '/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm'  # This loads nvm bash_completion

# Customize the command prompt:
autoload -U colors && colors
PROMPT='[%F{208}ellm%f %F{039}%1~%f ]$ '

# History:
HISTSIZE=10000
SAVEHIST=10000

# Completetion:
autoload -Uz compinit
# auto-complete w/ keyboard
zstyle ':completion:*' menu select
# case-insensitive completion
zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z}={A-Za-z}'
zmodload zsh/complist
compinit
# bind up/down arrow keys to traverse history autocomplete hinting
bindkey '\e[A' history-beginning-search-backward
bindkey '\e[B' history-beginning-search-forward

## Show git info:
autoload -Uz vcs_info
precmd_vcs_info() { vcs_info }
precmd_functions+=( precmd_vcs_info )
setopt prompt_subst
RPROMPT=\$vcs_info_msg_0_
zstyle ':vcs_info:git:*' formats '%F{240}(%b)%r%f'
zstyle ':vcs_info:*' enable git

# Alias:
alias ga="git add"
alias gaa="git add -A"
alias gss="git status -s"
alias gco="git checkout"
alias gl="git log --pretty=format:'%C(auto)%h%Creset - %C(bold green)%ar%Creset - %C(cyan)%an%Creset - %C(blue)%s%Creset' --date=relative"
alias glm="git log"
alias gc="git commit"
alias gcm="git commit -m"
alias gcbail="git merge --abort"
alias gpick="git cherry-pick"
alias gccopy="git rev-parse HEAD | xargs printf %s | pbcopy" # copy last commit hash
alias gbcopy="git rev-parse --abbrev-ref HEAD | xargs printf %s | pbcopy" # copy branch name

## NPM
alias nrb="npm run build"
alias nrd="npm run dev"
## Folder navigation
alias ..="cd .."
alias ...="cd ../.."
## File and directory viewing
alias ls="ls -lG"
## Text Editing
alias vi="nvim"
alias vim="nvim"

# Helper functions
glg() {
  gl --grep="$1" $2
}

# Startup screen
cat <<'EOF'
░        ░░  ░░░░░░░░  ░░░░░░░░  ░░░░  ░
▒  ▒▒▒▒▒▒▒▒  ▒▒▒▒▒▒▒▒  ▒▒▒▒▒▒▒▒   ▒▒   ▒
▓      ▓▓▓▓  ▓▓▓▓▓▓▓▓  ▓▓▓▓▓▓▓▓        ▓
█  ████████  ████████  ████████  █  █  █
█        ██        ██        ██  ████  █

EOF
echo "================"
php -v
echo "================"
print "Node version: $(node -v)"
print "NPM version:  $(npm -v)"
echo "================"

# Check for outdated global packages (but only once per day)
PACKAGES_OUTDATED_CACHE="$HOME/.packages_outdated_last_run"
TODAY=$(date +%Y-%m-%d)
if [ ! -f "$PACKAGES_OUTDATED_CACHE" ] || [ "$(cat "$PACKAGES_OUTDATED_CACHE")" != "$TODAY" ]; then
  echo "Checking for outdated global npm packages..."
  npm outdated -g --depth=0 || echo "No outdated packages found or npm error."
  echo "Checking for outdated homebrew packages..."
  brew outdated
  echo "$TODAY" > "$PACKAGES_OUTDATED_CACHE"
fi

# Activate zsh-autosuggestions.
source $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh

# Include external configs:
[ -f "$HOME/.zshrclocal" ] && source "$HOME/.zshrclocal"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion
